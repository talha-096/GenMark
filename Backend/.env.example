# Flask configuration
PORT=5000
SECRET_KEY=your_flask_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/GenMarkDB?retryWrites=true&w=majority

# AWS S3 Configuration (Optional, falls back to local storage if keys are missing)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=your_aws_region

# AI Services Integration (Kaggle-only mode)
# ── Kaggle Model Server (Primary AI Backend) ───────────────────────────────────
# Run Model/kaggle_model_server.ipynb on Kaggle (GPU T4 x2, internet ON).
# After running Step 5, copy the ngrok URL printed there and paste it below.
# Example: https://abc123.ngrok-free.app
KAGGLE_MODEL_URL=https://your-ngrok-url.ngrok-free.app
